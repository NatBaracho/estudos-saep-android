// Site do Estudos SAEP na Cloudflare (Workers com arquivos estáticos).
// Publica a pasta www/ (a mesma tela do app Android; o progresso fica no navegador de cada pessoa).
// Publicar:  npm run site:publicar   (precisa ter feito "npx wrangler@4 login" uma vez)
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "estudos-saep",
  "account_id": "f01e5d2816a3193a1bf6be2252806aaa",   // conta da Cloudflare (não é segredo)
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "www"
  }
}

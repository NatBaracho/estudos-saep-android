{
  "name": "estudos-saep-android",
  "version": "1.0.0",
  "private": true,
  "description": "App Android do Estudos SAEP: simulados, aulas e treino por tema, funcionando sem internet.",
  "scripts": {
    "android:criar": "cap add android",
    "android:icones": "capacitor-assets generate --android",
    "android:sync": "cap sync android",
    "site:publicar": "npx --yes wrangler@4 deploy",
    "site:testar": "npx --yes wrangler@4 dev"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
